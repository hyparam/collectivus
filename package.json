{
  "name": "collectivus",
  "version": "1.1.0",
  "description": "OTLP collector and pass-through LLM proxy that records every request and response to JSONL",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "collectivus": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsdoc": "62.9.0",
    "globals": "17.6.0",
    "hyparquet": "1.25.6",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "optionalDependencies": {
    "hyparquet-writer": "0.14.0"
  },
  "keywords": [
    "opentelemetry",
    "otlp",
    "collector",
    "traces",
    "metrics",
    "logs",
    "anthropic",
    "claude",
    "llm-proxy",
    "claude-code"
  ],
  "license": "MIT"
}
